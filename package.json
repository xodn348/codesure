{
  "name": "codesure",
  "version": "1.0.0",
  "description": "Privacy-first MCP security scanner for AI-generated code",
  "type": "module",
  "bin": { "codesure": "dist/index.js" },
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "src/rules/malicious/",
    "src/rules/vulnerability/"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/index.js",
    "prepare": "npm run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0",
    "web-tree-sitter": "^0.24.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0",
    "@types/js-yaml": "^4.0.9",
    "shx": "^0.3.4",
    "bun-types": "latest"
  }
}
